STOCK_ENVIRONMENT=development
STOCK_MLFLOW_TRACKING_URI=http://localhost:5000
STOCK_MODEL_NAME=stock-ranking-model
STOCK_MODEL_VERSION=baseline-vn-2026-01

# ── MLflow Model Inference ────────────────────────────────────────────────────
# Set to true AFTER you have trained a model and promoted it to Production.
# When false, the forecast node uses a heuristic linear formula instead.
STOCK_USE_MLFLOW_MODEL=true
# Stage to load from MLflow Model Registry: Production | Staging
STOCK_MLFLOW_MODEL_STAGE=Production

# ── Vietnamese Market Settings ────────────────────────────────────────────────
STOCK_MARKET=VN
STOCK_VNSTOCK_MARKET=HOSE
STOCK_RISK_FREE_RATE=0.045
STOCK_CURRENCY=VND

# ── Live Market Data (ETL) ────────────────────────────────────────────────────
# Set STOCK_USE_REAL_MARKET_DATA=true to fetch live HOSE data via vnstock3
# (requires: pip install vnstock3)
STOCK_USE_REAL_MARKET_DATA=true
STOCK_MARKET_DATA_SOURCE=vnstock

# Tickers to fetch (comma-separated HOSE symbols)
STOCK_VNSTOCK_TICKERS=VCB,BID,MBB,TCB,VPB,ACB,FPT,VIC,VHM,HPG,VNM,SAB,GAS,MSN,REE

# ── Training Configuration ────────────────────────────────────────────────────
# Forward return horizon for label_builder (trading days, default 21 ≈ 1 month)
STOCK_TRAINING_HORIZON_DAYS=21

# ── Optional LLM for explanation node ────────────────────────────────────────
STOCK_LLM_PROVIDER=template
# STOCK_OPENAI_API_KEY=sk-...
# STOCK_GEMINI_API_KEY=...
